# URL pública del sitio (canonical, sitemap y Open Graph).
SITE_URL=https://nattul.pages.dev

# Planilla de Google Sheets publicada como CSV (Archivo > Compartir > Publicar en la web > CSV).
# Si está vacía, el build usa PRODUCTS_CSV_PATH.
PRODUCTS_CSV_URL=

# Archivo local de productos para desarrollo y demo.
PRODUCTS_CSV_PATH=data/productos-demo.csv

# Origen de las imágenes externas (por ejemplo, el dominio público de Cloudflare R2). Se agrega a la CSP.
IMAGES_ORIGIN=

# Subcarpeta donde vive el sitio (solo para GitHub Pages, por ejemplo /nattul-website). Vacía en Cloudflare.
BASE_PATH=
