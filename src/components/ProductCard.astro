---
import ProductImage from "@/components/ProductImage.astro";
import { productUrl } from "@/lib/catalog";
import { TAG_LABELS, type Product } from "@/lib/products";

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<article class="flex w-full flex-col">
  <a href={productUrl(product.slug)} class="group block">
    <ProductImage src={product.image} alt="" />
    <h3 class="mt-3 font-display text-lg leading-snug text-deep group-hover:underline md:text-xl">{product.name}</h3>
  </a>
  <p class="mt-1 text-sm text-muted">{product.unit}</p>
  {product.tags.length > 0 && <p class="mt-1 text-xs font-medium text-leaf">{product.tags.map((tag) => TAG_LABELS[tag]).join(", ")}</p>}
  <div class="mt-auto pt-3">
    {
      product.available ? (
        <button
          type="button"
          data-add-to-cart
          data-slug={product.slug}
          data-name={product.name}
          data-unit={product.unit}
          class="inline-flex h-11 w-full items-center justify-center rounded-full bg-forest px-4 text-sm font-medium text-cream"
          aria-label={`Agregar ${product.name} al pedido`}
        >
          <span data-label>Agregar</span>
        </button>
      ) : (
        <span class="text-sm text-muted">Sin stock</span>
      )
    }
  </div>
</article>
