---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Página no encontrada" description="La página que buscás no existe o cambió de dirección." noindex>
  <section class="mx-auto max-w-3xl px-gutter py-20 text-center md:px-6">
    <p class="font-display text-6xl text-leaf">404</p>
    <h1 class="mt-4 font-display text-4xl text-deep">No encontramos esta página</h1>
    <p class="mt-4 text-muted">Puede que el producto ya no esté en el catálogo o que el enlace tenga un error.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/buscar/" class="inline-flex h-12 items-center rounded-full bg-forest px-5 font-medium text-cream">Buscar productos</a>
      <a href="/" class="inline-flex h-12 items-center rounded-full border border-forest px-5 font-medium text-forest">Ir al inicio</a>
    </div>
  </section>
</BaseLayout>
