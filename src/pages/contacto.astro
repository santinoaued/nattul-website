---
import { site } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";

const greeting = encodeURIComponent("Hola! Quería hacer una consulta.");
// Static icon markup (Lucide outlines), not user data.
const socials = [
  {
    name: "Instagram",
    text: "Novedades y productos nuevos",
    url: site.social.instagram,
    icon: '<rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><path d="M17.5 6.5h.01"/>',
  },
  {
    name: "Facebook",
    text: "Seguinos y escribinos",
    url: site.social.facebook,
    icon: '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>',
  },
];
---

<BaseLayout title="Contacto y sucursales" description="Sucursales, horarios, WhatsApp y redes de Nattul.">
  <section class="mx-auto max-w-6xl px-gutter py-10 md:px-6 md:py-14">
    <h1 class="font-display text-4xl text-deep md:text-5xl">Contacto y sucursales</h1>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={`mailto:${site.email}`} class="inline-flex h-12 items-center rounded-full border border-forest px-5 font-medium text-forest">{site.email}</a>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {
        site.branches.map((branch) => (
          <article class="rounded-card bg-deep p-6 text-cream">
            <h2 class="font-display text-3xl">{branch.name}</h2>
            <address class="mt-3 not-italic text-foam">
              {branch.address}
              <br />
              {branch.city}
            </address>
            <p class="mt-3 text-foam">{branch.hours}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              <a href={`https://wa.me/${branch.whatsapp}?text=${greeting}`} target="_blank" rel="noopener noreferrer" class="inline-flex h-11 items-center rounded-full bg-cream px-4 text-sm font-medium text-deep">
                WhatsApp
              </a>
              {branch.mapsUrl && (
                <a href={branch.mapsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex h-11 items-center rounded-full border border-foam px-4 text-sm font-medium">
                  Cómo llegar
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>

    <h2 class="mt-14 font-display text-3xl text-deep">Seguinos</h2>
    <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:max-w-3xl">
      {
        socials.map((social) => (
          <li>
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 rounded-card border border-line bg-paper p-4 transition-colors hover:border-forest hover:bg-foam"
            >
              <span class="inline-flex size-14 shrink-0 items-center justify-center rounded-full bg-forest text-cream">
                <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={social.icon} />
              </span>
              <span>
                <span class="block font-display text-2xl text-deep">{social.name}</span>
                <span class="block text-sm text-muted">{social.text}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
