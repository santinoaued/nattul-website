---
import CartView from "@/components/islands/CartView";
import { site } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Tu pedido" description="Revisá tu lista y consultá precios por WhatsApp." noindex>
  <section class="mx-auto max-w-6xl px-gutter py-10 md:px-6 md:py-14">
    <h1 class="font-display text-4xl text-deep md:text-5xl">Tu pedido</h1>
    <div class="mt-8">
      <CartView client:only="preact" branches={site.branches.map(({ name, whatsapp }) => ({ name, whatsapp }))}>
        <p slot="fallback" class="text-muted">Cargando tu pedido…</p>
      </CartView>
    </div>
  </section>
</BaseLayout>
