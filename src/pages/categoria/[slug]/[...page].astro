---
import { href } from "@/lib/url";
import type { GetStaticPaths, Page } from "astro";
import Pagination from "@/components/Pagination.astro";
import ProductCard from "@/components/ProductCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCategories, getProducts, PAGE_SIZE } from "@/lib/catalog";
import type { Product } from "@/lib/products";

export const getStaticPaths = (async ({ paginate }) => {
  const products = await getProducts();
  return getCategories(products).flatMap((category) =>
    paginate(
      products.filter((product) => product.categorySlug === category.slug),
      { params: { slug: category.slug }, props: { category }, pageSize: PAGE_SIZE },
    ),
  );
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Product>;
  category: { name: string; count: number };
}

const { page, category } = Astro.props;
const suffix = page.currentPage > 1 ? `, página ${page.currentPage}` : "";
---

<BaseLayout
  title={`${category.name}${suffix}`}
  description={`${category.name}: ${category.count} productos para pedir por WhatsApp.`}
>
  <section class="mx-auto max-w-6xl px-gutter py-10 md:px-6 md:py-14">
    <nav aria-label="Ruta" class="text-sm text-muted">
      <a href={href("/")} class="underline">Inicio</a> / <span>{category.name}</span>
    </nav>
    <h1 class="mt-3 font-display text-4xl text-deep md:text-5xl">{category.name}</h1>
    <p class="mt-2 text-muted">{category.count} productos{suffix}</p>
    <h2 class="sr-only">Productos</h2>
    <div class="mt-8 grid grid-cols-2 gap-x-4 gap-y-10 md:grid-cols-3 lg:grid-cols-4">
      {page.data.map((product) => <ProductCard product={product} />)}
    </div>
    <Pagination current={page.currentPage} last={page.lastPage} prev={page.url.prev} next={page.url.next} />
  </section>
</BaseLayout>
