---
import { href } from "@/lib/url";
import { Picture } from "astro:assets";
import almendras from "@/assets/products/almendras.jpg";
import avena from "@/assets/products/avena.jpg";
import cacao from "@/assets/products/cacao.jpg";
import JsonLd from "@/components/JsonLd.astro";
import ProductCard from "@/components/ProductCard.astro";
import ProductImage from "@/components/ProductImage.astro";
import { site } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { categoryUrl, getCategories, getProducts } from "@/lib/catalog";

const products = await getProducts();
const categories = getCategories(products);
const business = {
  "@context": "https://schema.org",
  "@graph": site.branches.map((branch) => ({
    "@type": "LocalBusiness",
    "@id": new URL(href(`/#${branch.id}`), Astro.site).href,
    name: `${site.legalName}, ${branch.name}`,
    description: site.description,
    url: new URL(href("/"), Astro.site).href,
    image: new URL(href("/og.jpg"), Astro.site).href,
    telephone: `+${branch.whatsapp}`,
    email: site.email,
    address: { "@type": "PostalAddress", streetAddress: branch.address, addressLocality: branch.city, addressCountry: "AR" },
    sameAs: Object.values(site.social),
  })),
};
const featured = products.filter((product) => product.available && product.image).slice(0, 8);

const steps = [
  { title: "Elegí tus productos", text: "Buscá por nombre o recorré las categorías." },
  { title: "Armá tu pedido", text: "Sumá productos y ajustá las cantidades." },
  { title: "Envialo por WhatsApp", text: "Te respondemos con precios, stock y entrega." },
];
---

<BaseLayout>
  <JsonLd slot="head" data={business} />
  <section class="mx-auto grid max-w-6xl items-center gap-10 px-gutter py-12 md:grid-cols-2 md:px-6 md:py-20">
    <div>
      <p class="text-sm font-medium text-leaf">{site.branches.map((branch) => branch.city.split(",")[0]).join(" y ")}</p>
      <h1 class="mt-3 font-display text-4xl leading-tight text-deep md:text-6xl">{site.tagline}</h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">{site.description}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#catalogo" class="inline-flex h-12 items-center rounded-full bg-forest px-5 font-medium text-cream">Ver el catálogo</a>
        <a href={href("/como-comprar/")} class="inline-flex h-12 items-center rounded-full border border-forest px-5 font-medium text-forest">Cómo comprar</a>
      </div>
    </div>
    <div class="grid grid-cols-2 gap-3">
      <Picture src={almendras} alt="Almendras a granel" formats={["avif", "webp"]} widths={[320, 640]} sizes="(min-width: 768px) 25vw, 50vw" loading="eager" fetchpriority="high" class="row-span-2 h-full min-h-72 w-full rounded-card object-cover" />
      <Picture src={cacao} alt="Cacao amargo en polvo" formats={["avif", "webp"]} widths={[320, 640]} sizes="(min-width: 768px) 25vw, 50vw" loading="eager" class="h-36 w-full rounded-card object-cover md:h-48" />
      <Picture src={avena} alt="Avena arrollada" formats={["avif", "webp"]} widths={[320, 640]} sizes="(min-width: 768px) 25vw, 50vw" class="h-36 w-full rounded-card object-cover md:h-48" />
    </div>
  </section>

  <section class="border-y border-line bg-paper">
    <ol class="mx-auto grid max-w-6xl gap-8 px-gutter py-10 md:grid-cols-3 md:px-6">
      {
        steps.map((step, i) => (
          <li>
            <p class="font-display text-3xl text-leaf">{i + 1}</p>
            <p class="mt-2 font-medium">{step.title}</p>
            <p class="mt-1 text-sm leading-relaxed text-muted">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="catalogo" class="mx-auto max-w-6xl py-14 md:px-6 md:py-20">
    <div class="flex items-end justify-between gap-4 px-gutter md:px-0">
      <h2 class="font-display text-3xl text-deep md:text-5xl">Categorías</h2>
      <div class="hidden gap-2 md:flex">
        <button type="button" data-carousel-step="-1" class="inline-flex size-11 items-center justify-center rounded-full border border-line bg-paper text-lg text-forest" aria-label="Categorías anteriores">‹</button>
        <button type="button" data-carousel-step="1" class="inline-flex size-11 items-center justify-center rounded-full border border-line bg-paper text-lg text-forest" aria-label="Más categorías">›</button>
      </div>
    </div>
    <ul data-carousel class="no-scrollbar mt-8 flex snap-x snap-mandatory scroll-px-gutter gap-4 overflow-x-auto px-gutter md:scroll-px-0 md:px-0" aria-label="Categorías de productos">
      {
        categories.map((category) => (
          <li class="w-[72%] shrink-0 snap-start sm:w-[44%] md:w-[calc((100%-2rem)/3)]">
            <a href={categoryUrl(category.slug)} class="group block">
              <ProductImage src={category.image} alt="" />
              <p class="mt-4 font-display text-2xl text-deep group-hover:underline md:text-3xl">{category.name}</p>
              <p class="text-muted">{category.count} productos</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-6xl px-gutter pb-14 md:px-6 md:pb-20">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <h2 class="font-display text-3xl text-deep md:text-5xl">Destacados</h2>
      <a href={href("/buscar/")} class="text-sm font-medium text-forest underline">Ver todos los productos</a>
    </div>
    <div class="mt-8 grid grid-cols-2 gap-x-4 gap-y-10 md:grid-cols-3 lg:grid-cols-4">
      {featured.map((product) => <ProductCard product={product} />)}
    </div>
  </section>

  <section id="sucursales" class="bg-deep text-cream">
    <div class="mx-auto max-w-6xl px-gutter py-14 md:px-6 md:py-20">
      <h2 class="max-w-xl font-display text-3xl md:text-5xl">Dos sucursales, el mismo almacén.</h2>
      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        {
          site.branches.map((branch) => (
            <article id={branch.id} class="overflow-hidden rounded-card bg-forest">
              <iframe
                title={`Mapa de la ${branch.name}`}
                src={branch.mapEmbed}
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                class="h-64 w-full border-0"
              />
              <div class="p-5 md:p-6">
                <h3 class="font-display text-3xl">{branch.name}</h3>
                <address class="mt-2 not-italic text-foam">
                  {branch.address}, {branch.city}
                </address>
                <p class="mt-1 text-sm text-foam">{branch.hours}</p>
                <div class="mt-5 flex flex-wrap gap-2">
                  <a
                    href={`https://wa.me/${branch.whatsapp}?text=${encodeURIComponent("Hola! Quería hacer una consulta.")}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex h-11 items-center rounded-full bg-cream px-5 text-sm font-medium text-deep"
                  >
                    Escribir por WhatsApp
                  </a>
                  <a href={branch.mapsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex h-11 items-center rounded-full border border-foam px-5 text-sm font-medium">
                    Cómo llegar
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Category carousel: advances on its own until the visitor touches, scrolls, clicks or tabs into it.
  const track = document.querySelector<HTMLElement>("[data-carousel]");
  if (track) {
    const move = (direction: number) => {
      const card = track.firstElementChild as HTMLElement | null;
      if (!card) return;
      const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 8;
      const atStart = track.scrollLeft <= 8;
      if (direction > 0 && atEnd) track.scrollTo({ left: 0, behavior: "smooth" });
      else if (direction < 0 && atStart) track.scrollTo({ left: track.scrollWidth, behavior: "smooth" });
      else track.scrollBy({ left: direction * (card.offsetWidth + 16), behavior: "smooth" });
    };

    let hovered = false;
    const timer = matchMedia("(prefers-reduced-motion: reduce)").matches ? undefined : setInterval(() => !hovered && move(1), 3500);
    const stop = () => clearInterval(timer);
    for (const type of ["pointerdown", "wheel", "touchstart", "keydown", "focusin"]) track.addEventListener(type, stop, { once: true, passive: true });
    track.addEventListener("mouseenter", () => (hovered = true));
    track.addEventListener("mouseleave", () => (hovered = false));

    document.querySelectorAll<HTMLButtonElement>("[data-carousel-step]").forEach((button) =>
      button.addEventListener("click", () => {
        stop();
        move(Number(button.dataset.carouselStep));
      }),
    );
  }
</script>
