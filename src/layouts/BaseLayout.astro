---
import { href } from "@/lib/url";
import Footer from "@/components/Footer.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import Header from "@/components/Header.astro";
import { site } from "@/config/site";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "product";
  noindex?: boolean;
}

const { title, description = site.description, image = href("/og.jpg"), type = "website", noindex = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.legalName}` : `${site.legalName}: ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.legalName} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#295037" />
    <!-- Renamed when the icon changes: browsers cache favicons for a long time. -->
    <link rel="icon" type="image/svg+xml" href={href("/favicon-hojas.svg")} />
    <link rel="icon" type="image/png" sizes="48x48" href={href("/favicon-48.png")} />
    <link rel="apple-touch-icon" href={href("/apple-touch-icon.png")} />
    <link rel="sitemap" href={href("/sitemap.xml")} />
    <link rel="preload" href={href("/fonts/outfit-latin.woff2")} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={href("/fonts/fraunces-latin.woff2")} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-forest focus:px-4 focus:py-2 focus:text-cream">
      Saltar al contenido
    </a>
    <Header />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
    <p data-cart-status class="sr-only" aria-live="polite"></p>
    <script>
      import "@/scripts/cart-ui";
    </script>
  </body>
</html>
